generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================
enum WordType {
  NOUN
  VERB
  ADJ
  ADV
  @@map("word_type")
}

enum UserPlan {
  free
  pro
  @@map("user_plan")
}

enum PublishStatus {
  draft
  published
  @@map("publish_status")
}

enum GameMode {
  flashcard
  quiz
  match
  typing
  @@map("game_mode")
}

enum ItemType {
  consumable
  cosmetic
  content
  @@map("item_type")
}

// ============================================================
// AUTH MODELS (NextAuth compatible)
// ============================================================
model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  
  plan          UserPlan  @default(free)
  xp            Int       @default(0)
  level         Int       @default(1)
  coins         Int       @default(0)
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  accounts      Account[]
  sessions      Session[]
  logins        UserLogin[]
  userWords     UserWord[]
  userVocabSets UserVocabSet[]
  practiceSessions PracticeSession[]
  gamification  Gamification?
  userQuests    UserQuest[]
  inventory     UserInventoryItem[]
  badges        UserBadge[]
  transactions  EconomyTransaction[]
  createdSets   VocabSet[] @relation("CreatedBy")

  @@map("users")
}

model UserLogin {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  loggedAt       DateTime    @default(now()) @map("logged_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_logins")
}

model Account {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @db.Uuid
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// VOCALAB BUSINESS MODELS
// ============================================================

model DictionaryWord {
  id          String    @id @default(uuid()) @db.Uuid
  word        String
  phonetic    String?
  meaning     String
  type        WordType
  example     String?
  difficulty  Int?      
  tags        String[]  @default([])
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userWords   UserWord[]
  vocabSets   VocabSetWord[]
  sessionAnswers SessionAnswer[]

  @@unique([word, type])
  @@map("dictionary_words")
}

model UserWord {
  userId           String    @map("user_id") @db.Uuid
  wordId           String    @map("word_id") @db.Uuid
  
  learned          Boolean   @default(false)
  mastery          Int       @default(0)
  
  easeFactor       Float     @default(2.5) @map("ease_factor")
  intervalDays     Int       @default(0) @map("interval_days")
  reviewCount      Int       @default(0) @map("review_count")
  
  nextReviewAt     DateTime  @default(now()) @map("next_review_at")
  lastReviewedAt   DateTime? @map("last_reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@map("user_words")
}

model VocabSet {
  id            String    @id @default(uuid()) @db.Uuid
  createdBy     String?   @map("created_by") @db.Uuid
  title         String
  description   String?
  color         String    @default("from-green-400 to-emerald-500")
  coinPrice     Int       @default(0) @map("coin_price")
  isSystem      Boolean   @default(false) @map("is_system")
  isPublic      Boolean   @default(true) @map("is_public")
  status        PublishStatus @default(published)
  difficulty    Int?
  tags          String[]  @default([])
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator       User?     @relation("CreatedBy", fields: [createdBy], references: [id])
  words         VocabSetWord[]
  userVocabSets UserVocabSet[]

  @@map("vocab_sets")
}

model VocabSetWord {
  vocabSetId  String @map("vocab_set_id") @db.Uuid
  wordId       String @map("word_id") @db.Uuid

  vocabSet VocabSet @relation(fields: [vocabSetId], references: [id], onDelete: Cascade)
  word     DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([vocabSetId, wordId])
  @@map("vocab_set_words")
}

model UserVocabSet {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  vocabSetId     String    @map("vocab_set_id") @db.Uuid
  coinsPaid      Int       @default(0) @map("coins_paid")
  progressPercent Int       @default(0) @map("progress_percent")
  isFavorite     Boolean   @default(false) @map("is_favorite")
  unlockedAt     DateTime  @default(now()) @map("unlocked_at")
  completedAt    DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabSet VocabSet @relation(fields: [vocabSetId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabSetId])
  @@map("user_vocab_sets")
}

model PracticeSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  gameMode     GameMode  @map("game_mode")
  correct      Int       @default(0)
  total        Int       @default(0)
  xpEarned     Int       @default(0) @map("xp_earned")
  coinsEarned  Int       @default(0) @map("coins_earned")
  durationSeconds Int     @default(0) @map("duration_seconds")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers SessionAnswer[]

  @@map("sessions")
}

model SessionAnswer {
  id               String    @id @default(uuid()) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  wordId          String    @map("word_id") @db.Uuid
  isCorrect       Boolean   @map("is_correct")
  responseTimeMs  Int?      @map("response_time_ms")
  userAnswer      String?   @map("user_answer")
  createdAt       DateTime  @default(now()) @map("created_at")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word    DictionaryWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@map("session_answers")
}

model Gamification {
  userId         String    @id @map("user_id") @db.Uuid
  streak          Int       @default(0)
  bestStreak      Int       @default(0) @map("best_streak")
  lastActiveDay   DateTime? @map("last_active_day") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gamification")
}

model QuestTemplate {
  id            String    @id @default(uuid()) @db.Uuid
  questKey      String    @unique @map("quest_key")
  title         String
  description   String?
  goal          Int
  rewardXp      Int       @default(0) @map("reward_xp")
  rewardCoins     Int       @default(0) @map("reward_coins")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  userQuests    UserQuest[]

  @@map("quest_templates")
}

model UserQuest {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  templateId    String    @map("template_id") @db.Uuid
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  claimed       Boolean   @default(false)
  assignedDate  DateTime  @default(now()) @map("assigned_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  template QuestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId, assignedDate])
  @@map("user_quests")
}

model ShopItem {
  id            String    @id @default(uuid()) @db.Uuid
  itemKey       String    @unique @map("item_key")
  title         String
  description   String?
  price         Int       @default(0)
  itemType      ItemType  @map("item_type")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  userInventory UserInventoryItem[]

  @@map("shop_items")
}

model UserInventoryItem {
  userId       String    @map("user_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  quantity      Int       @default(1)
  purchasedAt  DateTime  @default(now()) @map("purchased_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("user_inventory_items")
}

model Badge {
  id            String    @id @default(uuid()) @db.Uuid
  badgeKey      String    @unique @map("badge_key")
  title         String
  description   String?
  iconUrl       String?   @map("icon_url")
  rarity        String    @default("common")
  createdAt     DateTime  @default(now()) @map("created_at")

  userBadges    UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId       String    @map("user_id") @db.Uuid
  badgeId      String    @map("badge_id") @db.Uuid
  earnedAt     DateTime  @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model EconomyTransaction {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String    
  currency      String    
  amount        Int
  source        String    
  referenceId   String?   @map("reference_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("economy_transactions")
}
